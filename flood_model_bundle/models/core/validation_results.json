  "multivariable_calibration_tradeoff": {
    "description": "Multi-variable calibration probe. Raising petco improves ET monotonically while degrading discharge. Only the incumbent meets all three thesis discharge thresholds, so the incumbent is retained.",
    "thresholds": {
      "nse": 0.5,
      "r2": 0.6,
      "abs_pbias": 25
    },
    "runs": [
      {
        "petco": 1.2,
